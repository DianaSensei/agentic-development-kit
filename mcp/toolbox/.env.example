# MCP Toolbox connection settings — copy this file to .env and fill in real
# values. .env is gitignored (see repo .gitignore: **/.env); this .example
# file IS committed so the required variables are documented for everyone.
#
# Toolbox does NOT read .env files itself — export them into the process
# environment before starting toolbox, e.g.:
#   set -a && source .env && set +a && ./toolbox --config tools.yaml

# --- PostgreSQL ---
# One block per datasource (see tools.yaml `sources`). The tools defined in
# tools.yaml are read-only by design, but Toolbox has no way to enforce that
# by inspecting SQL text — the real guarantee has to come from USER/PASSWORD
# below pointing at a SELECT-only DB role. Provisioning that role is outside
# the scope of this MCP setup (ask whoever administers the database for
# read-only credentials); never point this at a superuser or table-owning
# role.
POSTGRES_PRIMARY_HOST=127.0.0.1
POSTGRES_PRIMARY_PORT=5432
POSTGRES_PRIMARY_DATABASE=my_db
POSTGRES_PRIMARY_USER=my_user
POSTGRES_PRIMARY_PASSWORD=my_password

POSTGRES_ANALYTICS_HOST=127.0.0.1
POSTGRES_ANALYTICS_PORT=5432
POSTGRES_ANALYTICS_DATABASE=my_analytics_db
POSTGRES_ANALYTICS_USER=my_user
POSTGRES_ANALYTICS_PASSWORD=my_password

# To add a 3rd/4th Postgres datasource: add a new POSTGRES_<NAME>_* block
# here, plus a matching `kind: source` + tool blocks in tools.yaml.

# --- Redis ---
# host:port of the Redis instance
REDIS_ADDRESS=127.0.0.1:6379
# Leave blank if not using a non-default user / AUTH
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0

# --- MongoDB ---
MONGODB_URI=mongodb://my_user:my_password@127.0.0.1:27017
MONGODB_DATABASE=my_db
# Default collection used by the example mongodb_* tools in tools.yaml.
# Duplicate those tool blocks per collection you need to expose.
MONGODB_COLLECTION=my_collection
