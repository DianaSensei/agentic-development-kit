# Template: add a new SQL connection (any of Toolbox's supported SQL
# `type`s - postgres, mysql, tidb, mssql, sqlite, spanner, bigquery, etc;
# see https://mcp-toolbox.dev/documentation/reference/prebuilt-tools for
# the full list and each type's own source fields).
#
# HOW TO USE:
#   The easiest way is to just ask Claude Code, e.g. "add a toolbox
#   connection for my orders Postgres database" - it can read this file
#   and write the result straight into the right place. To do it by hand:
#   1. Copy this file into ${CLAUDE_PLUGIN_DATA}/connections/ (the
#      writable, persistent directory the bundled toolbox MCP reads from -
#      run `claude mcp get toolbox` to see the exact path, or ask Claude
#      Code "what's my CLAUDE_PLUGIN_DATA path?"), renamed to something
#      unique, e.g. `orders-db.yaml`.
#   2. Replace CONN_NAME everywhere below with a short, unique identifier
#      for this connection (e.g. `orders`) - it must not collide with any
#      other file's source/tool/toolset name already in that directory.
#   3. Fill in host/port/database/user/password with the real values,
#      directly (no need for env vars or a .env file) - this directory is
#      private to your machine, not committed to git or shared, so a
#      literal value here is safe, the same way a personal-scope MCP
#      entry in ~/.claude.json is.
#   4. Drop the .example extension isn't required for the file you
#      copied elsewhere, but leaving a copy of this template itself here
#      is safe - Toolbox only loads *.yaml/*.yml, so a .example file is
#      always ignored.
#
# The read-only guarantee (if you want one) comes from the DB account
# itself - point the user field at a SELECT-only role/account. Toolbox
# does not enforce this by inspecting SQL text.

kind: source
name: CONN_NAME-source
type: postgres  # change to mysql / tidb / mssql / sqlite / spanner / etc.
host: your-db-host
port: 5432
database: your-db-name
user: your-read-only-user
password: your-password

---
kind: tool
name: CONN_NAME_query_data
type: postgres-execute-sql  # match the source type, e.g. mysql-execute-sql
source: CONN_NAME-source
description: >-
  Run a read-only SQL query (SELECT) against the CONN_NAME database.
  Describe here what this database is for, so the agent knows when to use
  it - and any query patterns/system catalogs worth pointing out for
  introspection.
annotations:
  readOnlyHint: true
  destructiveHint: false

---
kind: tool
name: CONN_NAME_list_tables
type: postgres-list-tables  # match the source type, e.g. mysql-list-tables
source: CONN_NAME-source
description: >-
  List schema information for all or specified tables in the CONN_NAME
  database. Optional params: table_names (comma-separated), output_format
  (simple|detailed).
annotations:
  readOnlyHint: true

---
kind: toolset
name: CONN_NAME-toolset
tools:
  - CONN_NAME_query_data
  - CONN_NAME_list_tables
