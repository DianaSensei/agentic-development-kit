# Grafana MCP server (https://github.com/grafana/mcp-grafana) connection
# settings - copy this file to .env and fill in real values. .env is
# gitignored (see repo .gitignore: **/.env); this .example file IS committed
# so the required variables are documented for everyone.
#
# This file is only a value store: `claude mcp add` (User scope) bakes these
# into ~/.claude.json at registration time - it does not read .env live. On
# each new device: fill in .env, then re-run the registration command in
# README.md so the values get picked up.

# Base URL of your Grafana instance.
# Self-hosted: http://localhost:3000
# Grafana Cloud: https://<your-instance>.grafana.net
GRAFANA_URL=http://localhost:3000

# Grafana Service Account Token (Administration > Service accounts > Add
# service account > Add token). Needs at least Viewer role; higher roles
# unlock more MCP tools (e.g. Editor for provisioning/annotations, Admin
# for admin tools).
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# Optional: numeric org ID, only needed for multi-org Grafana instances.
# GRAFANA_ORG_ID=1
