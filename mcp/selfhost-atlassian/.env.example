# Atlassian MCP server (https://github.com/sooperset/mcp-atlassian)
# connection settings for Jira + Confluence Server/Data Center (PAT auth) -
# copy this file to .env and fill in real values. .env is gitignored (see
# repo .gitignore: **/.env); this .example file IS committed so the required
# variables are documented for everyone.
#
# Self-hosted (Server/Data Center) only. On Atlassian Cloud, use the
# official Rovo MCP server instead - see README.md.
#
# `mcp-atlassian` reads this file directly via --env-file at process start
# (see README.md) - no need to export these into the shell first. On a new
# device: fill in .env, then run the registration command in README.md once.

# --- Jira (Server/Data Center) ---
JIRA_URL=https://jira.internal.company.com
JIRA_PERSONAL_TOKEN=
# Only needed if your instance uses a self-signed/internal CA cert not in
# the OS trust store. Leave at true (default) otherwise.
# JIRA_SSL_VERIFY=true

# --- Confluence (Server/Data Center) ---
CONFLUENCE_URL=https://confluence.internal.company.com
CONFLUENCE_PERSONAL_TOKEN=
# CONFLUENCE_SSL_VERIFY=true

# --- Access control (recommended) ---
# Disables all write tools (create/update/delete/transition) - only
# search/read tools remain callable. Flip to "false" only when you
# specifically need the agent to write to Jira/Confluence.
READ_ONLY_MODE=true

# Optional: restrict which Jira projects / Confluence spaces are visible at
# all, regardless of READ_ONLY_MODE. Comma-separated keys.
# JIRA_PROJECTS_FILTER=PROJ,DEV,SUPPORT
# CONFLUENCE_SPACES_FILTER=DEV,TEAM,DOC
