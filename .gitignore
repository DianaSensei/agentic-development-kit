# Per-session state written by the quality-check hooks (hooks/) into whichever
# project the plugin is enabled in - when testing this repo against itself via
# `claude --plugin-dir .`, that project is this repo.
# Review markers and block counters are local facts about a working tree, never shared.
.claude/state/

# Local hook overrides (e.g. turning a gate off on one machine) stay out of the repo.
.claude/settings.local.json

# Written by `claude plugin eval` on every run (evals/README.md).
evals/results/

# Bytecode Python writes next to maintain/ and metrics/ scripts when they run.
__pycache__/
*.pyc
